# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file to version control.

# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transplant_db
# Used by the backend container (host name "postgres" = the docker-compose service name)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/transplant_db

# ---------- Backend / JWT ----------
# Generate a real random secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000

# ---------- Redis (used starting Phase 9) ----------
REDIS_URL=redis://redis:6379/0
